[http]
	cookiefile = /usr/local/google/home/frs/.gitcookies
[credential]
	helper = corpsso
[alias]
  co = checkout
  br = branch
  rb = rebase 
  lg = log --oneline 
  st = status
  dv = difftool -d
[user]
	name = Feras Aldahlawi
	email = feras@chromium.org
[pull]
	rebase = true
[oh-my-zsh]
	hide-status = 1
	hide-dirty = 1
[advice]
	skippedCherryPicks = false
[merge]
	tool = codediff
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "codediff"]
	cmd = "CD_MERGED=\"$MERGED\" nvim \"$MERGED\" -c \"lua vim.cmd('CodeDiff --exit-on-close merge ' .. vim.fn.fnameescape(vim.env.CD_MERGED))\""
	trustExitCode = true
[diff]
	tool = codediff
[difftool]
	prompt = false
[difftool "codediff"]
	cmd = "if [ -d \"$LOCAL\" ]; then CD_LOCAL=\"$LOCAL\" CD_REMOTE=\"$REMOTE\" nvim -c \"lua vim.cmd('CodeDiff --exit-on-close dir ' .. vim.fn.fnameescape(vim.env.CD_LOCAL) .. ' ' .. vim.fn.fnameescape(vim.env.CD_REMOTE))\"; else CD_LOCAL=\"$LOCAL\" CD_REMOTE=\"$REMOTE\" nvim \"$LOCAL\" \"$REMOTE\" -c \"lua vim.cmd('CodeDiff --exit-on-close file ' .. vim.fn.fnameescape(vim.env.CD_LOCAL) .. ' ' .. vim.fn.fnameescape(vim.env.CD_REMOTE))\"; fi"
[core]
  editor = nvim
	filemode = false
	autocrlf = false
[rerere]
	enabled = true
[branch]
	autosetuprebase = always
[cache]
	cachepath = /usr/local/google/big-files/git_cache_path
